class Solution {
    public List<Boolean> kidsWithCandies(int[] candies, int extraCandies) {
        List<Boolean> answer = new ArrayList<>();
        for(int i=0 ; i<candies.length ; i++){
            int temp = candies[i] + extraCandies ;
            answer.add(true);
            for(int j=0 ; j<candies.length ; j++){
                
                if(temp < candies[j]){
                    answer.set(i,false);
                    break;
                }
                
            }
        }
        return answer ;
    }
}



// lesser time 
class Solution {
    public List<Boolean> kidsWithCandies(int[] candies, int extraCandies) {
        List<Boolean> answer = new ArrayList<>();
        int max = 0;
        for(int i=0 ; i<candies.length ; i++){
            if(candies[i] > max){
                max = candies[i];
            }
        }
        for(int i=0 ; i<candies.length ; i++){
            boolean ans = (candies[i] + extraCandies) >= max;
            answer.add(ans);
        }
        return answer ;
    }
}
