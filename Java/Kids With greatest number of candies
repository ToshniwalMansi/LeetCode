class Solution {
    public List<Boolean> kidsWithCandies(int[] candies, int extraCandies) {
        List<Boolean> answer = new ArrayList<>();
        for(int i=0 ; i<candies.length ; i++){
            int temp = candies[i] + extraCandies ;
            answer.add(true);
            for(int j=0 ; j<candies.length ; j++){
                
                if(temp < candies[j]){
                    answer.set(i,false);
                    break;
                }
                
            }
        }
        return answer ;
    }
}
