class Solution {
    public int findNumbers(int[] nums) {
        
        int ans =0;
        for(int i=0 ; i<nums.length ; i++){
            int counter =0;
            while(nums[i] != 0){
                nums[i] = nums[i]/10 ;
                counter ++;
            }
            if(counter % 2 == 0){
                ans ++ ;
            }
        }
        return ans;
    }
}


// To not destroy original values
class Solution {
    public int findNumbers(int[] nums) {
        
        int ans =0;
        for(int i=0 ; i<nums.length ; i++){
            int counter =0;
            int num = nums[i];
            while(num != 0){
                num = num/10 ;
                counter ++;
            }
            if(counter % 2 == 0){
                ans ++ ;
            }
        }
        return ans;
    }
}

// Another method but takes more memory and the above one beats 99$ and this one beats 33%

class Solution {
    public int findNumbers(int[] nums) {
        
        int ans =0;

        for(int i=0 ; i<nums.length ; i++){
            if(String.valueOf(nums[i]).length() % 2 == 0){
                ans ++;
            }
        }
        return ans;
    }    
}
