class Solution {
    public boolean isAnagram(String s, String t) {
        
        if(s.length() != t.length()){
            return false; 
        }

        char[] old = s.toCharArray();
        char[] anagram = t.toCharArray();

        Arrays.sort(old);
        Arrays.sort(anagram);

        return Arrays.equals(old , anagram);
    }
}
