class Solution {
    public int lengthOfLastWord(String s) {
        
        int length = s.length()-1;
        int word = 0;
        boolean counting = false;

        for(int i=length ; i>=0 ; i--){
            if(s.charAt(i) != ' '){
                word++ ;
                counting = true;
            }
            else{
                if(counting){
                    break;
                }
            }
            
        }
        
        return word;
    }
}
