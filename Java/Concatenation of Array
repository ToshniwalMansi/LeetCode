class Solution {
    public int[] getConcatenation(int[] nums) {
        int[] newArray = new int[2*nums.length];
        int length = nums.length;
        for(int i=0 ; i<nums.length ; i++){
            newArray[i] = nums[i];
            newArray[length+i] = nums[i];
        }

        return newArray ;
    }
}
